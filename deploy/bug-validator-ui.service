# systemd user unit for the web UI, next to bug-validator.service. Install and operate:
# .about/architecture.md, Deploy. Machine-specific as there: WorkingDirectory, the node path, the log.

[Unit]
Description=Bug Validator UI — the web view of the checks
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
WorkingDirectory=%h/npb/bug-validator
Environment=PATH=%h/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=TZ=Europe/Warsaw
# Opened from the office network by the server's address. The default is this machine only;
# firewall the port to the LAN, and set UI_USER and UI_PASSWORD in .env for a login.
Environment=UI_HOST=0.0.0.0
ExecStart=%h/.nvm/versions/node/v24.19.0/bin/node server/cli.ts ui
Restart=always
RestartSec=5
NoNewPrivileges=yes
StandardOutput=append:%h/npb/bug-validator/state/ui.log
StandardError=append:%h/npb/bug-validator/state/ui.log

[Install]
WantedBy=default.target

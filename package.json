{
  "name": "bug-validator",
  "version": "0.1.0",
  "description": "Checks new WebUI bugs in Jira and comments on what they are missing",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts run",
    "check": "tsc --noEmit && prettier --check .",
    "test": "vitest run",
    "format": "prettier --write .",
    "ui": "node src/main.ts ui",
    "request": "node src/main.ts request",
    "maintain": "node src/main.ts maintain"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}

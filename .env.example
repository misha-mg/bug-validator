# Copy to .env and chmod 600 it. Every variable: docs/architecture.md, Configuration.

# Jira REST, basic auth. A scoped API token from id.atlassian.com (docs/jira-reference.md).
JIRA_EMAIL=
JIRA_API_TOKEN=

# Claude: `claude setup-token` once, paste the result. Empty: this machine's own claude login.
CLAUDE_CODE_OAUTH_TOKEN=

# true (default): comments go to the database and the log, nothing is written to Jira.
DRY_RUN=true
AGENT_MODEL=haiku

# The web UI (its unit opens it to the network with UI_HOST=0.0.0.0). Both set: a login.
# UI_USER=
# UI_PASSWORD=
# Names the UI is opened by besides its IP address, comma-separated.
# UI_HOSTNAMES=

# Copy to .env and chmod 600 it. Every variable: .about/architecture.md, Configuration.
# A variable already in the environment wins over this file.

# The Jira site (for links and the cloud id lookup) and the login: basic auth with a scoped API
# token from id.atlassian.com (.about/jira-reference.md).
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# The site's cloud id; read from <JIRA_BASE_URL>/_edge/tenant_info when unset.
# JIRA_CLOUD_ID=

# Claude: `claude setup-token` once, paste the result. Required: the agent's sandbox has no other login.
CLAUDE_CODE_OAUTH_TOKEN=

# The WebUI repository the agent reads, cloned by the service into VALIDATOR_WEBUI_DIR (default
# state/webui) with this machine's git credentials (an SSH key that reads it).
VALIDATOR_WEBUI_REPO_URL=git@bitbucket.org:your-org/webui.git

# true (default): comments go to the database and the log, nothing is written to Jira.
VALIDATOR_DRY_RUN=true
# VALIDATOR_POLL_INTERVAL_SECONDS=180
# The agent's model and caps (provisional until the measurement, the PRD's Rollout step 3).
# VALIDATOR_AGENT_MODEL=sonnet
# VALIDATOR_AGENT_TIMEOUT_SECONDS=600
# VALIDATOR_AGENT_MAX_TURNS=100
# VALIDATOR_AGENT_MAX_BUDGET_USD=2

# Slack: a message for every check that ends not understood, through an incoming webhook (a Slack
# app with Incoming Webhooks on; the URL is a secret: anyone holding it can post). Unset: no
# messages. The switch turns them off while the URL stays in place.
# VALIDATOR_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# VALIDATOR_SLACK_NOTIFICATIONS=true   (the default of the console's Slack setting, which wins once set)
# The console as a person opens it, for the link in a message; unset, the message links to Jira alone.
# VALIDATOR_CONSOLE_URL=http://<server-ip>:8081
# The tools' start page: set, the mark in the console's masthead leads to it, as every tool's logo does.
# VALIDATOR_PORTAL_URL=http://<tools-server>/

# Where the service keeps its files; the defaults are under state/ in the working directory.
# VALIDATOR_DB_FILE=state/bug-validator.sqlite
# VALIDATOR_LOG_FILE=state/service.log
# VALIDATOR_BACKUP_DIR=state/backups

# The branch of origin `update` (the bug-validator-update timer) follows; the checkout must be on it.
# VALIDATOR_UPDATE_BRANCH=main

# The web UI: this machine only by default (its unit opens it to the network with
# VALIDATOR_HOST=0.0.0.0). Both of user and password set: a login.
# VALIDATOR_HOST=127.0.0.1
# VALIDATOR_PORT=8081
# VALIDATOR_USER=
# VALIDATOR_PASSWORD=
# Names the UI is opened by besides its IP address, comma-separated.
# VALIDATOR_HOSTNAMES=

# Copy to .env and chmod 600 it. Every variable: docs/architecture.md, Configuration.

# Jira REST, basic auth. A scoped API token from id.atlassian.com (docs/jira-reference.md).
JIRA_EMAIL=
JIRA_API_TOKEN=

# Claude: `claude setup-token` once, paste the result. Required: the agent's sandbox has no other login.
CLAUDE_CODE_OAUTH_TOKEN=

# true (default): comments go to the database and the log, nothing is written to Jira.
DRY_RUN=true
# The agent's model and caps (provisional until the measurement, docs/prd.md Rollout step 3).
# AGENT_MODEL=sonnet
# AGENT_TIMEOUT_SECONDS=600
# AGENT_MAX_TURNS=100
# AGENT_MAX_BUDGET_USD=2

# The WebUI repository the agent reads, cloned by the service into WEBUI_DIR (default state/webui),
# with this machine's git credentials.
# WEBUI_REPO_URL=git@bitbucket.org:CGS/webui.git

# The web UI (its unit opens it to the network with UI_HOST=0.0.0.0). Both set: a login.
# UI_USER=
# UI_PASSWORD=
# Names the UI is opened by besides its IP address, comma-separated.
# UI_HOSTNAMES=

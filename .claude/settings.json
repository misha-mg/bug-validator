{
	"enabledMcpjsonServers": [
		"jira",
		"atlassian-rovo"
	],
	"attribution": {
		"commit": "",
		"pr": ""
	},
	"permissions": {
		"allow": [
			"mcp__jira__get_issue",
			"mcp__jira__search_issues",
			"mcp__jira__get_attachments"
		],
		"deny": [
			"mcp__jira__add_comment",
			"mcp__jira__transition_issue",
			"mcp__atlassian-rovo__executeWrite",
			"mcp__atlassian-rovo__executeDestructive",
			"mcp__atlassian-rovo__addOrEditJiraIssueComment",
			"mcp__atlassian-rovo__createJiraIssue",
			"mcp__atlassian-rovo__editJiraIssue",
			"mcp__atlassian-rovo__transitionJiraIssue",
			"Read(./.env)",
			"mcp__claude_ai_Atlassian_Rovo__addCommentToJiraIssue",
			"mcp__claude_ai_Atlassian_Rovo__editJiraIssue",
			"mcp__claude_ai_Atlassian_Rovo__transitionJiraIssue",
			"mcp__claude_ai_Atlassian_Rovo__createJiraIssue",
			"mcp__claude_ai_Atlassian_Rovo__createIssueLink",
			"mcp__claude_ai_Atlassian_Rovo__addWorklogToJiraIssue",
			"mcp__atlassian-rovo__createConfluenceContent",
			"mcp__atlassian-rovo__updateConfluenceContent",
			"mcp__atlassian-rovo__addGraphContext"
		]
	}
}
